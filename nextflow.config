// Basic execution configuration; adjust executor/container settings
// as needed for your compute environment.

params {
    data_dir     = null
    primer_map   = null
    outdir       = "results"
    fasta_suffix = ".final.unique.fasta"
}

process {
    executor = 'local'
    cpus     = 1
    memory   = '2 GB'

    // Uncomment and adjust if running in a container environment
    // container = 'python:3.11-slim'
}

// Make sure scripts in bin/ are picked up automatically and added to PATH
// (this is default Nextflow behavior — no extra config needed as long as
// bin/ sits next to main.nf).

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_trace.txt"
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_report.html"
}